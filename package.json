{
  "$schema": "./package.schema.json",
  "license": "MIT",
  "name": "@jive-sh/skill-sync",
  "version": "0.4.12",
  "type": "module",
  "description": "Keeps one skills directory identical across every machine you work on.",
  "peerDependencies": {
    "effect": "^4.0.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "effect": "^4.0.0",
    "typescript": "^5.9.3",
    "jive-abstract-library": "0.2.0"
  },
  "scripts": {
    "jive:cicd:get-config": "jive-library cicd get-config",
    "jive:cicd:build": "jive-library cicd build",
    "jive:cicd:audit": "tsc --noEmit -p tsconfig.json && bun test",
    "jive:cicd:deploy:plan": "jive-library cicd deploy-plan",
    "jive:cicd:upload-artifacts": "jive-library cicd upload-artifacts",
    "jive:cicd:deploy": "jive-library cicd deploy",
    "build:local": "bun ../../jive-abstract-library/src/entrypoints/jive-library.ts cicd build",
    "install:local": "bun run build:local && bun uninstall --global @jive-sh/skill-sync ; bun add -g \"$(pwd)/dist/base\""
  },
  "jive": {
    "cicd": {
      "deploy": {
        "verb": "Publish Tag",
        "branches": {
          "main": [
            "latest"
          ]
        },
        "previews": false,
        "sequentially": true
      },
      "runsOnPullRequests": true,
      "runsOn": "ubuntu-latest",
      "requiredSecrets": [
        "NPM_TOKEN"
      ]
    },
    "library": {
      "daemons": [
        "skill-sync-daemon"
      ]
    }
  },
  "dependencies": {
    "commander": "^13.1.0"
  }
}
