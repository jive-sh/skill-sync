{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jive-skill-sync",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "d1_databases": [
    { "binding": "DB", "database_name": "jive-skill-sync-db", "database_id": "dfdfeddf-7624-4bb9-84f5-4044c2518736" }
  ],
  "r2_buckets": [
    { "binding": "CONTENT", "bucket_name": "jive-skill-sync-content" }
  ],
  "routes": [
    { "pattern": "skill-sync.jive.sh", "custom_domain": true }
  ]
}
